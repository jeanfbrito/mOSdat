# mosdat test framework — environment variables
# Copy this file to .env and fill in your values.
# TOML config values take precedence over env vars; env vars take precedence over defaults.

# ---------------------------------------------------------------------------
# Proxmox (REQUIRED)
# ---------------------------------------------------------------------------
PROXMOX_HOST=192.168.1.10          # e.g. 192.168.13.85 — REQUIRED, no default
PROXMOX_PASSWORD=changeme           # Proxmox API password — REQUIRED, no default

# Proxmox (optional — defaults shown)
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_NODE=pve
PROXMOX_GPU_PCI=0000:01:00

# ---------------------------------------------------------------------------
# VLM (REQUIRED if VLM features are used)
# ---------------------------------------------------------------------------
# VLM_BASE_URL accepts multiple comma-separated URLs for failover.
# Try each in order; advance on connection/5xx/429/timeout errors.
# VLM_BASE_URL=http://primary:5001/v1,http://backup:5001/v1
VLM_BASE_URL=http://192.168.1.10:5001/v1   # REQUIRED if VLM used, no default

# VLM (optional — defaults shown)
VLM_MODEL=holo2-4b
VLM_VERIFY_MODEL=qwen3-vl-abliterated       # RECOMMENDED: general VLM for yes/no verify; localization-specialized models (holo2, ui-tars, osatlas, seeclick, cogvlm-cogagent) hallucinate on yes/no — set this or VLMClient raises ValueError

# ---------------------------------------------------------------------------
# Functional tests (REQUIRED if functional.enabled = true in TOML)
# ---------------------------------------------------------------------------
FUNCTIONAL_WORKSPACE_URL=https://your-workspace.example.com
FUNCTIONAL_TEST_USER=testuser
FUNCTIONAL_TEST_PASSWORD=changeme
